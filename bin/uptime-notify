#!/usr/bin/env bash
# Fixed alert text only: never consume output from the HTTP check.
set -euo pipefail
exec python3 - <<'PY'
import datetime
import json
import os
import re
import subprocess


def gh(*args):
    return subprocess.check_output(["gh", *args], text=True).strip()


def api(path, **fields):
    args = ["api", path, "--method", "PATCH"]
    for key, value in fields.items():
        args.extend(["-f", f"{key}={value}"])
    gh(*args)


repo = os.environ["GH_REPO"]
run = int(os.environ["RUN_NUMBER"])
url = os.environ["RUN_URL"]
recipient = os.environ["RECIPIENT"]
drill = os.environ.get("IS_DRILL") == "true"
healthy = os.environ.get("CHECK_RESULT") == "success"
now = int(datetime.datetime.now(datetime.timezone.utc).timestamp())
time = datetime.datetime.fromtimestamp(now, datetime.timezone.utc).isoformat()


def marker(body, key):
    match = re.search(r"<!-- uptime-" + key + r": ([0-9]+) -->", body)
    return int(match[1]) if match else 0


def state(body, failed, notified):
    body = re.sub(r"\n?<!-- uptime-(?:last-failed-run|last-notified-at):.*? -->", "", body)
    return (body + f"\n<!-- uptime-last-failed-run: {failed} -->"
            + f"\n<!-- uptime-last-notified-at: {notified} -->")


def create():
    label = "uptime-drill" if drill else "production-down"
    prefix = "DRILL: " if drill else ""
    body = (f"{prefix}@{recipient} Lease Manager public checks failed at {time}.\n\n"
            f"Inspect the [workflow run]({url}) for details.")
    body = state(body, run, now)
    gh("label", "create", label, "--repo", repo, "--force")
    gh("issue", "create", "--repo", repo, "--title", prefix + "Lease Manager public checks failed",
       "--body", body, "--label", label, "--assignee", recipient)


if drill:
    if healthy:
        raise SystemExit("Drill passed unexpectedly; no alert was tested.")
    create()
else:
    alerts = []
    for label in (["production-down", "uptime-drill"] if healthy else ["production-down"]):
        pages = json.loads(gh("api", f"repos/{repo}/issues?state=open&labels={label}&per_page=100",
                              "--paginate", "--slurp"))
        alerts.extend(issue for page in pages for issue in page
                      if issue.get("user", {}).get("login") == "github-actions[bot]"
                      and "pull_request" not in issue)
    if not healthy and not alerts:
        create()
    for issue in alerts:
        number = str(issue["number"])
        body = issue.get("body") or ""
        failed = marker(body, "last-failed-run")
        notified = marker(body, "last-notified-at")
        if healthy:
            if run <= failed:
                print(f"Leaving alert {number} open: run is not newer than its failure.")
                continue
            gh("issue", "comment", number, "--repo", repo, "--body",
               f"@{recipient} Lease Manager public checks recovered at {time}. [Workflow run]({url}).")
            api(f"repos/{repo}/issues/{number}", state="closed", state_reason="completed")
        else:
            if now - notified >= 12 * 60 * 60:
                gh("issue", "comment", number, "--repo", repo, "--body",
                   f"@{recipient} Lease Manager public checks still fail at {time}. [Workflow run]({url}).")
                notified = now
            api(f"repos/{repo}/issues/{number}", body=state(body, max(failed, run), notified))
PY
