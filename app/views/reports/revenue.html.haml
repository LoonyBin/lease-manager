- content_for :title, "Revenue Report"

.flex.justify-end.mb-6
  = link_to reports_path, class: "btn btn-ghost btn-sm gap-2" do
    = heroicon "arrow-left", options: { class: "w-4 h-4" }
    Back to Overview

.card.bg-base-100.shadow-xl.mb-8
  .card-body
    %h2.card-title Revenue by Month
    .overflow-x-auto
      %table.table.table-zebra
        %thead
          %tr
            %th Month
            %th.text-right Amount
        %tbody
          - @invoices_by_month.each do |month, amount|
            %tr
              %td= month.strftime("%B %Y")
              %td.text-right= number_to_currency(amount, unit: "₹")
        %tfoot
          %tr.font-bold
            %td Total
            %td.text-right= number_to_currency(@invoices_by_month.values.sum, unit: "₹")

.card.bg-base-100.shadow-xl
  .card-body
    %h2.card-title Revenue by Property
    .overflow-x-auto
      %table.table.table-zebra
        %thead
          %tr
            %th Property
            %th.text-right Amount
        %tbody
          - @invoices_by_property.each do |property, amount|
            %tr
              %td= property.name
              %td.text-right= number_to_currency(amount, unit: "₹")
