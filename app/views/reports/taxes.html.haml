- content_for :title, "Tax Report"
- content_for :page_title, "Tax Report"

.flex.justify-end.mb-6
  = link_to reports_path, class: "btn btn-ghost btn-sm gap-2" do
    = heroicon "arrow-left", options: { class: "w-4 h-4" }
    Back to Overview

.card.bg-base-100.shadow-xl
  .card-body
    .flex.justify-between.items-center.mb-4
      %h2.card-title Taxes by Month
      .badge.badge-secondary.badge-lg= number_to_currency(@total_taxes, unit: "₹")

    .overflow-x-auto
      %table.table.table-zebra
        %thead
          %tr
            %th Month
            %th.text-right Tax Amount
        %tbody
          - @taxes_by_month.each do |month, amount|
            %tr
              %td= month.strftime("%B %Y")
              %td.text-right= number_to_currency(amount, unit: "₹")
        %tfoot
          %tr.font-bold
            %td Total
            %td.text-right= number_to_currency(@total_taxes, unit: "₹")
