- content_for :title, "Overview"

.space-y-6

  -# Summary Cards
  .grid.grid-cols-1.sm:grid-cols-2.lg:grid-cols-4.gap-4
    .stat-card
      .stat-card-header
        %span.stat-label Revenue (MTD)
        .stat-icon.stat-icon-green
          = heroicon "arrow-right", options: { class: "w-4 h-4 rotate-[-45deg]" }
      .stat-value= number_to_currency(@total_revenue, unit: "₹")
      .stat-subtext.text-success
        = link_to "View details →", revenue_reports_path

    .stat-card
      .stat-card-header
        %span.stat-label Outstanding
        .stat-icon.stat-icon-amber
          = heroicon "exclamation-circle", options: { class: "w-4 h-4" }
      .stat-value= number_to_currency(@total_outstanding, unit: "₹")
      .stat-subtext
        = link_to "View details →", outstanding_reports_path

    .stat-card
      .stat-card-header
        %span.stat-label Collected
        .stat-icon.stat-icon-blue
          = heroicon "check-circle", options: { class: "w-4 h-4" }
      .stat-value= number_to_currency(@total_collected, unit: "₹")
      .stat-subtext Confirmed payments, net of refunds

    .stat-card
      .stat-card-header
        %span.stat-label Total Taxes
        .stat-icon.stat-icon-indigo
          = heroicon "receipt-tax", options: { class: "w-4 h-4" }
      .stat-value= number_to_currency(@total_taxes, unit: "₹")
      .stat-subtext
        = link_to "View details →", taxes_reports_path

  -# Charts Section
  .grid.grid-cols-1.lg:grid-cols-3.gap-6
    -# Main Revenue Chart
    .lg:col-span-2.dashboard-card
      .dashboard-card-header
        %h3.dashboard-card-title Revenue vs Collection
        %span.dashboard-badge Last 12 Months
      .dashboard-card-body
        = line_chart [{ name: "Billed", data: @revenue_by_month }, { name: "Collected", data: @payments_by_month }], colors: ["#6366f1", "#10b981"], thousands: ",", prefix: "₹", curve: false, loading: "Loading..."

    -# Occupancy Chart
    .dashboard-card
      .dashboard-card-header
        %h3.dashboard-card-title Occupancy Rate
      .dashboard-card-body
        = pie_chart @occupancy_stats, donut: true, colors: ["#10b981", "#e2e8f0"], legend: "bottom", loading: "Loading..."

  -# Secondary Charts
  .grid.grid-cols-1.lg:grid-cols-2.gap-6
    .dashboard-card
      .dashboard-card-header
        %h3.dashboard-card-title Invoice Status Breakdown
      .dashboard-card-body
        = column_chart @invoice_status_distribution, colors: ["#6366f1"], loading: "Loading..."
