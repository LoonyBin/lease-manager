- content_for :page_title, @tenant.name

- content_for :page_actions do
  - if policy(@tenant).edit?
    = link_to edit_tenant_path(@tenant), class: "btn btn-ghost btn-sm btn-square", title: "Edit" do
      = heroicon "pencil-square", options: { class: "w-5 h-5" }
  - if policy(@tenant).destroy?
    = button_to tenant_path(@tenant), method: :delete, class: "btn btn-ghost btn-sm btn-square text-error", data: { turbo_confirm: "Are you sure you want to delete this tenant?" }, title: "Delete" do
      = heroicon "trash", options: { class: "w-5 h-5" }
  %label.btn.btn-ghost.btn-sm.btn-square{for: "history-drawer", title: "History"}
    = heroicon "clock", options: { class: "w-5 h-5" }

.drawer.drawer-end
  %input#history-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content
    .show-card
      .show-section
        .show-field
          .show-field-label Email
          .show-field-value= mail_to @tenant.email, class: "link link-primary"
        .show-field
          .show-field-label Phone
          .show-field-value= @tenant.phone_number

      .show-section
        .show-section-header
          %h3.show-section-title Leases
          = link_to leases_path(q: { tenant_id_eq: @tenant.id }), class: "btn btn-ghost btn-xs", title: "View all" do
            = heroicon "arrows-pointing-out", options: { class: "w-4 h-4" }

        - active_leases = @tenant.leases.active_at(Date.current).includes(:property)
        - if active_leases.any?
          .show-list
            - active_leases.each do |lease|
              .show-list-item
                .show-list-item-title= link_to lease.property.name, lease, class: "link link-primary"
                .show-list-item-meta= number_to_currency(lease.rent_amount, unit: "₹", precision: 0)
                .show-list-item-badge
                  %span.resource-badge.resource-badge-success Active
        - else
          .show-empty No active leases

      .show-section
        %h3.show-section-title Associated Users

        - if @tenant.users.any?
          .show-tags
            - @tenant.user_associations.includes(:user).each do |assoc|
              .show-tag
                = assoc.user.name
                - if policy(assoc).destroy?
                  = button_to user_association_path(assoc), method: :delete, class: "show-tag-remove", data: { turbo_confirm: "Remove this association?" }, aria: { label: "Remove #{assoc.user.name}" } do
                    = heroicon "x-mark", options: { class: "w-3 h-3" }
        - else
          .show-empty.mb-4 No users associated

        - if policy(UserAssociation).create?
          = form_with model: UserAssociation.new, class: "show-inline-form" do |f|
            = f.hidden_field :associable_type, value: "Tenant"
            = f.hidden_field :associable_id, value: @tenant.id
            = f.collection_select :user_id, User.where.not(id: @tenant.user_ids).order(:name), :id, :name, { prompt: "Select user..." }, class: "select select-bordered select-sm flex-1"
            = f.submit "Add", class: "btn btn-sm btn-primary"

  .drawer-side
    %label.drawer-overlay{for: "history-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      = render "shared/history_sidebar", item: @tenant
