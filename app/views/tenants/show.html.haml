.drawer.drawer-end
  %input#history-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content
    .max-w-2xl.mx-auto
      .flex.justify-between.items-start.mb-6
        %h1.text-2xl.font-bold Tenant Details
        .flex.gap-2
          - if policy(@tenant).edit?
            = link_to edit_tenant_path(@tenant), class: "btn btn-sm btn-ghost", aria: { label: "Edit" } do
              = heroicon "pencil-square", options: { class: "w-4 h-4" }
          %label.btn.btn-ghost.btn-sm.btn-circle{for: "history-drawer"}
            = heroicon "clock", options: { class: "w-4 h-4" }
            %span.sr-only History

      .grid.grid-cols-1.md:grid-cols-2.gap-4.mb-6
        %div
          %h3.font-bold.text-sm.opacity-70 Name
          %p= @tenant.name
        %div
          %h3.font-bold.text-sm.opacity-70 Email
          %p= @tenant.email
        %div
          %h3.font-bold.text-sm.opacity-70 Phone
          %p= @tenant.phone_number

      .divider

      %h3.text-lg.font-bold.mb-4 Associated Users

      - if @tenant.users.any?
        .flex.flex-wrap.gap-2.mb-4
          - @tenant.user_associations.includes(:user).each do |assoc|
            .badge.badge-outline.gap-2
              = assoc.user.name
              - if policy(assoc).destroy?
                = button_to user_association_path(assoc), method: :delete, class: "btn btn-ghost btn-xs p-0", data: { turbo_confirm: "Remove this association?" }, aria: { label: "Remove #{assoc.user.name}" } do
                  = heroicon "x-mark", options: { class: "w-4 h-4" }
      - else
        %p.text-base-content.opacity-50.mb-4 No users associated.

      - if policy(UserAssociation).create?
        = form_with model: UserAssociation.new, class: "flex gap-2" do |f|
          = f.hidden_field :associable_type, value: "Tenant"
          = f.hidden_field :associable_id, value: @tenant.id
          = f.collection_select :user_id, User.where.not(id: @tenant.user_ids).order(:name), :id, :name, { prompt: "Select user to add..." }, class: "select select-bordered select-sm flex-1"
          = f.submit "Add", class: "btn btn-sm btn-primary"

  .drawer-side
    %label.drawer-overlay{for: "history-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      = render "shared/history_sidebar", item: @tenant

