- content_for :page_title, "Tenants"

- content_for :page_actions do
  %label.btn.btn-ghost.btn-sm.btn-square{for: "filter-drawer"}
    = heroicon "funnel", options: { class: "w-5 h-5" }
  - if policy(@tenants.new).new?
    = link_to new_tenant_path, class: "btn btn-ghost btn-sm btn-square" do
      = heroicon "plus", options: { class: "w-5 h-5" }

.drawer.drawer-end
  %input#filter-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content.flex.flex-col
    = render_active_filters(@q)

    .overflow-x-auto
      %table.table.w-full
        %thead
          %tr
            %th= sort_link(@q, :name, "Name")
            %th= sort_link(@q, :email, "Email")
            %th= sort_link(@q, :phone_number, "Phone")
            %th.text-center Actions
        %tbody
          - @tenants.each do |tenant|
            %tr.hover.cursor-pointer{data: { controller: "clickable-row", clickable_row_url_value: tenant_path(tenant), action: "click->clickable-row#click" }}
              %td.font-medium= link_to tenant.name, tenant, class: "link link-hover"
              %td= tenant.email
              %td= tenant.phone_number
              %td.text-center
                - if policy(tenant).edit? || policy(tenant).destroy?
                  .join
                    - if policy(tenant).edit?
                      = link_to edit_tenant_path(tenant), class: "btn btn-sm btn-ghost join-item", aria: { label: "Edit #{tenant.name}" } do
                        = heroicon "pencil-square", options: { class: "w-4 h-4" }
                    - if policy(tenant).destroy?
                      = link_to tenant, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn btn-sm btn-ghost text-error join-item", aria: { label: "Delete #{tenant.name}" } do
                        = heroicon "trash", options: { class: "w-4 h-4" }

    = paginate @tenants

  .drawer-side
    %label.drawer-overlay{for: "filter-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      %h3.text-lg.font-bold.mb-4 Filter Tenants
      = render "search"
      = render "search"
