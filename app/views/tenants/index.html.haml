.flex.justify-between.items-center.mb-6
  %h1.text-2xl.font-bold Tenants
  - if policy(@tenants.new).new?
    = link_to 'New Tenant', new_tenant_path, class: "btn btn-primary"

.overflow-x-auto
  %table.table.w-full
    %thead
      %tr
        %th Name
        %th Email
        %th Phone
        %th.text-center Actions
    %tbody
      - @tenants.each do |tenant|
        %tr.hover.cursor-pointer{data: { controller: "clickable-row", clickable_row_url_value: tenant_path(tenant), action: "click->clickable-row#click" }}
          %td.font-medium= link_to tenant.name, tenant, class: "link link-hover"
          %td= tenant.email
          %td= tenant.phone_number
          %td.text-center
            - if policy(tenant).edit? || policy(tenant).destroy?
              .join
                - if policy(tenant).edit?
                  = link_to edit_tenant_path(tenant), class: "btn btn-sm btn-ghost join-item", aria: { label: "Edit #{tenant.name}" } do
                    = heroicon "pencil-square", options: { class: "w-4 h-4" }
                - if policy(tenant).destroy?
                  = link_to tenant, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn btn-sm btn-ghost text-error join-item", aria: { label: "Delete #{tenant.name}" } do
                    = heroicon "trash", options: { class: "w-4 h-4" }

= paginate @tenants
