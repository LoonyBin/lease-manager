- content_for :page_title, "Tenants"

- content_for :page_actions do
  -# View toggle (desktop only)
  .view-toggle-group.hidden.lg:flex
    %input#view-toggle.view-toggle-input{type: "checkbox"}
    %label.view-toggle-btn{for: "view-toggle", data: { view: "card" }, title: "Card view"}
      = heroicon "squares-2x2", options: { class: "w-4 h-4" }
    %label.view-toggle-btn{for: "view-toggle", data: { view: "table" }, title: "Table view"}
      = heroicon "list-bullet", options: { class: "w-4 h-4" }
  %label.btn.btn-ghost.btn-sm.btn-square{for: "sort-drawer", title: "Sort"}
    = heroicon "bars-arrow-down", options: { class: "w-5 h-5" }
  %label.btn.btn-ghost.btn-sm.btn-square{for: "filter-drawer", title: "Filter"}
    = heroicon "funnel", options: { class: "w-5 h-5" }
  - if policy(@tenants.new).new?
    = link_to new_tenant_path, class: "btn btn-ghost btn-sm btn-square", title: "New Tenant" do
      = heroicon "plus", options: { class: "w-5 h-5" }

.drawer.drawer-end
  %input#sort-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content
    .drawer.drawer-end
      %input#filter-drawer.drawer-toggle{type: "checkbox"}
      .drawer-content.flex.flex-col
        = render_active_filters(@q)

        -# Single markup - CSS handles card vs table display
        .tenant-list
          -# Table header (visible only in table view on desktop)
          .tenant-list-header
            .tenant-col-name Name
            .tenant-col-email Email
            .tenant-col-phone Phone
            .tenant-col-leases Leases
            .tenant-col-actions Actions

          -# Tenant items
          - @tenants.each do |tenant|
            - active_leases = tenant.leases.active_at(Date.current).count

            .tenant-item{data: { controller: "clickable-row", clickable_row_url_value: tenant_path(tenant), action: "click->clickable-row#click" }}
              .tenant-col-name
                .tenant-item-icon
                  = heroicon "user", options: { class: "w-5 h-5" }
                = link_to tenant.name, tenant, class: "tenant-item-name"
              .tenant-col-email
                .tenant-item-email
                  = heroicon "envelope", options: { class: "w-3.5 h-3.5 shrink-0 hidden-table" }
                  %span= tenant.email
              .tenant-col-phone
                .tenant-item-phone
                  = heroicon "phone", options: { class: "w-3.5 h-3.5 shrink-0 hidden-table" }
                  %span= tenant.phone_number
              .tenant-col-leases
                .tenant-item-leases
                  - if active_leases > 0
                    %span.tenant-item-badge.tenant-item-badge-active
                      = pluralize(active_leases, "active lease")
                  - else
                    %span.tenant-item-badge.tenant-item-badge-none No active leases
              .tenant-col-actions
                .tenant-item-actions
                  - if policy(tenant).edit?
                    = link_to edit_tenant_path(tenant), class: "btn btn-sm btn-ghost", aria: { label: "Edit #{tenant.name}" } do
                      = heroicon "pencil-square", options: { class: "w-4 h-4" }
                  - if policy(tenant).destroy?
                    = link_to tenant, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn btn-sm btn-ghost text-error", aria: { label: "Delete #{tenant.name}" } do
                      = heroicon "trash", options: { class: "w-4 h-4" }
                = link_to tenant, class: "tenant-item-link" do
                  View Details
                  = heroicon "chevron-right", options: { class: "w-4 h-4" }

        = paginate @tenants

      .drawer-side
        %label.drawer-overlay{for: "filter-drawer", aria: { label: "close sidebar" }}
        .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
          %h3.text-lg.font-bold.mb-4 Filter Tenants
          = render "search"

  .drawer-side
    %label.drawer-overlay{for: "sort-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      %h3.text-lg.font-bold.mb-4 Sort Tenants
      = render "sort"
