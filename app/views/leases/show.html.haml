.card.w-full.bg-base-100.shadow-xl.mx-auto
  .card-body
    %h2.card-title.mb-4 Lease Details

    .grid.grid-cols-1.md:grid-cols-2.gap-4
      %div
        %p.mb-2
          %strong Property:
          = @lease.property.name
        %p.mb-2
          %strong Tenant:
          = @lease.tenant.name
        %p.mb-2
          %strong Start Date:
          = @lease.start_date
        %p.mb-2
          %strong End Date:
          = @lease.end_date
          - if @lease.terminated_on
            %span.text-error (Terminated)
        %p.mb-2
          %strong Duration:
          = "#{@lease.duration_months} months"

      %div
        %p.mb-2
          %strong Rent Amount:
          = number_to_currency(@lease.rent_amount)
        %p.mb-2
          %strong Security Deposit (Months):
          = @lease.security_deposit_in_months
        %p.mb-2
          %strong Security Deposit (Total):
          = number_to_currency(@lease.security_deposit)
        %p.mb-2
          %strong Enhancement Period:
          = "#{@lease.enhancement_period_months} months"
        %p.mb-2
          %strong Enhancement:
          - if @lease.enhancement_amount.present?
            = @lease.enhancement_amount
            = @lease.percentage? ? "%" : "₹"

    .divider

    %h3.text-lg.font-bold.mb-4 Invoices

    .overflow-x-auto
      %table.table.w-full
        %thead
          %tr
            %th Month
            %th Status
            %th Amount
            %th Actions
        %tbody
          - @lease.billable_months.reverse.each do |month|
            - invoice = @lease.invoices.find { |i| i.date.beginning_of_month == month }
            %tr
              %td= month.strftime("%B %Y")
              - if invoice
                %td
                  %span{class: "badge badge-#{invoice.paid? ? 'success' : invoice.draft? ? 'ghost' : 'info'}"}
                    = invoice.status.humanize
                %td= number_to_currency(invoice.total_amount)
                %td
                  = link_to "View", invoice_path(invoice), class: "btn btn-xs btn-ghost"
              - else
                %td
                  %span.badge.badge-warning Missing
                %td -
                %td
                  = button_to "Generate", generate_invoices_path(lease_id: @lease.id, date: month.to_s), method: :post, class: "btn btn-xs btn-primary"

    .card-actions.justify-end.mt-6
      = link_to 'Edit', edit_lease_path(@lease), class: "btn btn-primary"
      - unless @lease.terminated_on
        %label.btn.btn-warning{for: "terminate-modal"} Terminate
        = button_to "Renew", renew_lease_path(@lease), method: :post, class: "btn btn-success", data: { turbo_confirm: "This will terminate the current lease and create a renewed lease. Continue?" }
      = link_to 'Back', leases_path, class: "btn btn-ghost"

-# Termination Modal
%input#terminate-modal.modal-toggle{type: "checkbox"}
.modal{role: "dialog"}
  .modal-box
    %h3.text-lg.font-bold Terminate Lease
    %p.py-4 Set the termination date for this lease. This will end the lease early.
    = form_with url: terminate_lease_path(@lease), method: :patch, class: "mt-4" do |f|
      .form-control
        %label.label
          %span.label-text Termination Date
        %input.input.input-bordered.w-full{type: "date", name: "terminated_on", required: true, min: @lease.start_date.to_s, max: @lease.end_date&.to_s}
      .modal-action
        %label.btn.btn-ghost{for: "terminate-modal"} Cancel
        %button.btn.btn-warning{type: "submit"} Terminate
