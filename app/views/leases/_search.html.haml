= search_form_for @q, class: "flex flex-col gap-4 p-4" do |f|
  %h3.text-lg.font-bold Filters
  .form-control
    = f.label :property_name_cont, "Property", class: "label-text"
    = f.search_field :property_name_cont, class: "input input-bordered input-sm w-full"
  .form-control
    = f.label :tenant_name_cont, "Tenant", class: "label-text"
    = f.search_field :tenant_name_cont, class: "input input-bordered input-sm w-full"

  .form-control
    = f.label :start_date_gteq, "Start From", class: "label-text"
    = f.date_field :start_date_gteq, class: "input input-bordered input-sm w-full"
  .form-control
    = f.label :start_date_lteq, "Start To", class: "label-text"
    = f.date_field :start_date_lteq, class: "input input-bordered input-sm w-full"

  .form-control
    = f.label :rent_amount_gteq, "Rent Min", class: "label-text"
    = f.number_field :rent_amount_gteq, class: "input input-bordered input-sm w-full", step: "0.01"
  .form-control
    = f.label :rent_amount_lteq, "Rent Max", class: "label-text"
    = f.number_field :rent_amount_lteq, class: "input input-bordered input-sm w-full", step: "0.01"

  .form-control
    = f.label :by_status, "Status", class: "label-text"
    = f.select :by_status,
        [["Active", "active"], ["Upcoming", "upcoming"], ["Expired", "expired"], ["Terminated", "terminated"]],
        { include_blank: "All" },
        class: "select select-bordered select-sm w-full"

  .flex.gap-2.mt-4
    = f.submit "Apply Filters", class: "btn btn-primary btn-sm flex-1"
    = link_to "Clear", leases_path, class: "btn btn-ghost btn-sm"
