.flex.justify-between.items-center.mb-6
  %h1.text-2xl.font-bold Leases
  - if policy(@leases.new).new?
    = link_to 'New Lease', new_lease_path, class: "btn btn-primary"

.overflow-x-auto
  %table.table.w-full
    %thead
      %tr
        %th Property
        %th Tenant
        %th Start Date
        %th End Date
        %th Duration
        %th.text-right Rent
        %th.text-center Actions
    %tbody
      - @leases.each do |lease|
        %tr.hover.cursor-pointer{data: { controller: "clickable-row", clickable_row_url_value: lease_path(lease), action: "click->clickable-row#click" }}
          %td= link_to lease.property.name, lease, class: "link link-hover font-medium"
          %td= lease.tenant.name
          %td= lease.start_date
          %td
            = lease.end_date
            - if lease.terminated_on
              %span.text-error (Terminated)
          %td= "#{lease.duration_months} months"
          %td.text-right= number_to_currency(lease.rent_amount)
          %td.text-center
            - if policy(lease).edit? || policy(lease).destroy?
              .join
                - if policy(lease).edit?
                  = link_to edit_lease_path(lease), class: "btn btn-sm btn-ghost join-item", aria: { label: "Edit lease for #{lease.property.name}" } do
                    = heroicon "pencil-square", options: { class: "w-4 h-4" }
                - if policy(lease).destroy?
                  = link_to lease, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn btn-sm btn-ghost text-error join-item", aria: { label: "Delete lease for #{lease.property.name}" } do
                    = heroicon "trash", options: { class: "w-4 h-4" }

= paginate @leases
