= simple_form_for(lease) do |f|
  = f.error_notification
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

  - if f.object.renewed_from_id
    = f.hidden_field :renewed_from_id
    .alert.alert-info.mb-4
      %span Renewing lease ##{f.object.renewed_from_id}

  = f.grid_inputs do
    = f.association :property, presettable: true, collection: policy_scope(Property).order(:name)
    = f.association :tenant

    = f.input :quantity, hint: "Amount of property capacity to lease. Available: #{lease.property&.available_capacity || 'N/A'}"

    = f.input :property_schedule, col: 4, as: :text, input_html: { rows: 2 },
              hint: "Defaults to property name and address. Edit to customise what appears on invoices."

    = f.input :start_date, as: :date, html5: true
    = f.input :duration_months

    = f.input :rent_amount
    = f.input :security_deposit_value, as: :string do
      .join.w-full.flex{data: {controller: "security-deposit-toggle"}}
        = f.input_field :security_deposit_value, class: "input input-bordered join-item w-full min-w-0",
                        data: { security_deposit_toggle_target: "valueInput",
                                action: "input->security-deposit-toggle#markEdited" }
        = f.hidden_field :security_deposit_type, value: f.object.security_deposit_type || "months",
                         data: { security_deposit_toggle_target: "typeInput" }
        %button.btn.join-item{type: "button",
                              data: { action: "click->security-deposit-toggle#toggle",
                                      security_deposit_toggle_target: "buttonLabel" }}
          = f.object.security_deposit_months? ? "\u00d7 months" : "\u20b9"

    = f.input :enhancement_amount, as: :string do
      .join.w-full.flex{data: {controller: "enhancement-toggle", renewed_from_id: f.object.renewed_from_id}}
        = f.input_field :enhancement_amount, class: "input input-bordered join-item w-full",
                        data: { enhancement_toggle_target: "amountInput" }
        = f.hidden_field :enhancement_type, value: f.object.enhancement_type || (f.object.renewed_from_id ? "inherit" : "percentage"),
                         data: { enhancement_toggle_target: "typeInput" }
        %button.btn.join-item{type: "button", data: { action: "click->enhancement-toggle#toggle", enhancement_toggle_target: "buttonLabel" }}
          - if f.object.inherit?
            = "\u{1F517}"
          - elsif f.object.percentage?
            = "%"
          - else
            ₹
    = f.input :enhancement_period_months

    = f.input :tax_rate, placeholder: "e.g., 18", hint: "Seeds the default invoice template when the lease is created."
    = f.input :tax_name, placeholder: "e.g., GST"

    = f.input :payment_due_in, as: :duration, units: [:months, :days], label: "Payment Due In", hint: "Set to 0 for payment due on invoice date. Seeds the default invoice template; edit the lease's invoice templates to change it later."

    - if f.object.terminated_on.present?
      = f.input :terminated_on, col: 4, as: :date, html5: true
      = f.input :archived_at, col: 4, as: :date, html5: true, hint: "Set to archive this lease for historical reference only."

    = f.input :reminders_enabled, as: :boolean, label: "Send Invoice Reminders",
              hint: "Queues reminders for this lease's unsettled invoices. Each one still needs approving in the outbox before it is sent."

    = f.input :documents, col: 4, as: :file, input_html: { multiple: true },
              label: "Upload Documents (PDF, images)", hint: "You can select multiple files"

  = f.form_actions
