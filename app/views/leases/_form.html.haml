= simple_form_for(lease) do |f|
  = f.error_notification
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

  - if f.object.renewed_from_id
    = f.hidden_field :renewed_from_id
    .alert.alert-info.mb-4
      %span Renewing lease ##{f.object.renewed_from_id}

  = f.grid_inputs do
    = f.association :property
    = f.association :tenant

    = f.input :quantity, hint: "Amount of property capacity to lease. Available: #{lease.property&.available_capacity || 'N/A'}"

    .col-span-1.md:col-span-2
      = f.input :property_schedule, as: :text, input_html: { rows: 2 },
                hint: "Defaults to property name and address. Edit to customise what appears on invoices."

    = f.input :start_date, as: :date, html5: true
    = f.input :duration_months

    = f.input :rent_amount
    = f.input :security_deposit_in_months

    = f.input :enhancement_amount, as: :string do
      .join.w-full.flex{data: {controller: "enhancement-toggle"}}
        = f.input_field :enhancement_amount, class: "input input-bordered join-item w-full"
        = f.hidden_field :enhancement_type, value: f.object.enhancement_type || "percentage", data: { enhancement_toggle_target: "typeInput" }
        %button.btn.join-item{type: "button", data: { action: "click->enhancement-toggle#toggle", enhancement_toggle_target: "buttonLabel" }}
          = f.object.percentage? ? "%" : "₹"
    = f.input :enhancement_period_months

    = f.input :tax_rate, placeholder: "e.g., 18"
    = f.input :tax_name, placeholder: "e.g., GST"

    - if f.object.terminated_on.present?
      .col-span-1.md:col-span-2
        = f.input :terminated_on, as: :date, html5: true

    .col-span-1.md:col-span-2
      = f.input :documents, as: :file, input_html: { multiple: true },
                label: "Upload Documents (PDF, images)", hint: "You can select multiple files"

  = f.form_actions
