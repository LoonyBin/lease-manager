.flex.justify-between.items-center.mb-6
  %h1.text-2xl.font-bold Properties
  = link_to 'New Property', new_property_path, class: "btn btn-primary"

.overflow-x-auto
  %table.table.w-full
    %thead
      %tr
        %th Name
        %th Address
        %th.text-center Actions
    %tbody
      - @properties.each do |property|
        %tr.hover
          %td.font-medium= property.name
          %td= property.address
          %td.text-center
            .join
              = link_to 'Show', property, class: "btn btn-sm btn-ghost join-item"
              = link_to 'Edit', edit_property_path(property), class: "btn btn-sm btn-ghost join-item"
              = link_to 'Destroy', property, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn btn-sm btn-ghost text-error join-item"
