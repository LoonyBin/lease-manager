.flex.justify-between.items-center.mb-6
  %h1.text-2xl.font-bold Properties
  - if policy(@properties.new).new?
    = link_to 'New Property', new_property_path, class: "btn btn-primary"

.overflow-x-auto
  %table.table.w-full
    %thead
      %tr
        %th Name
        %th Address
        %th.text-center Actions
    %tbody
      - @properties.each do |property|
        %tr.hover.cursor-pointer{data: { controller: "clickable-row", clickable_row_url_value: property_path(property), action: "click->clickable-row#click" }}
          %td.font-medium= link_to property.name, property, class: "link link-hover"
          %td= property.address
          %td.text-center
            - if policy(property).edit? || policy(property).destroy?
              .join
                - if policy(property).edit?
                  = link_to 'Edit', edit_property_path(property), class: "btn btn-sm btn-ghost join-item"
                - if policy(property).destroy?
                  = link_to 'Destroy', property, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn btn-sm btn-ghost text-error join-item"
