.drawer.drawer-end
  %input#filter-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content.flex.flex-col
    .flex.justify-between.items-center.mb-6
      %h1.text-2xl.font-bold Properties
      .flex.gap-2
        %label.btn.btn-ghost.btn-sm.gap-2{for: "filter-drawer"}
          = heroicon "funnel", options: { class: "w-4 h-4" }
          Filters
        - if policy(@properties.new).new?
          = link_to 'New Property', new_property_path, class: "btn btn-primary"

    = render_active_filters(@q)

    .overflow-x-auto
      %table.table.w-full
        %thead
          %tr
            %th= sort_link(@q, :name, "Name")
            %th= sort_link(@q, :address, "Address")
            %th.text-center Actions
        %tbody
          - @properties.each do |property|
            %tr.hover.cursor-pointer{data: { controller: "clickable-row", clickable_row_url_value: property_path(property), action: "click->clickable-row#click" }}
              %td.font-medium= link_to property.name, property, class: "link link-hover"
              %td= property.address
              %td.text-center
                - if policy(property).edit? || policy(property).destroy?
                  .join
                    - if policy(property).edit?
                      = link_to edit_property_path(property), class: "btn btn-sm btn-ghost join-item", aria: { label: "Edit #{property.name}" } do
                        = heroicon "pencil-square", options: { class: "w-4 h-4" }
                    - if policy(property).destroy?
                      = link_to property, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn btn-sm btn-ghost text-error join-item", aria: { label: "Delete #{property.name}" } do
                        = heroicon "trash", options: { class: "w-4 h-4" }

    = paginate @properties

  .drawer-side
    %label.drawer-overlay{for: "filter-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      %h3.text-lg.font-bold.mb-4 Filter Properties
      = render "search"
