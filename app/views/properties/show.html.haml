.card.w-96.bg-base-100.shadow-xl.mx-auto
  .card-body
    %h2.card-title Property Details

    %p
      %strong Owner:
      = @property.owner.name
    %p
      %strong Name:
      = @property.name
    %p
      %strong Address:
      = @property.address

    .card-actions.justify-end.mt-4
      - if policy(@property).edit?
        = link_to 'Edit', edit_property_path(@property), class: "btn btn-primary"
      = link_to 'Back', properties_path, class: "btn btn-ghost"
