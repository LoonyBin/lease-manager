= simple_form_for(property) do |f|
  = f.error_notification
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

  = f.grid_inputs do
    = f.input :name, col: 4
    = f.association :owner, col: 4
    = f.input :address, col: 4, as: :text, input_html: { rows: 3 }
    = f.input :capacity, hint: "Total capacity available for leasing"
    = f.input :unit, hint: "Unit of capacity (e.g., Rooms, Desks, Seats)"

  = f.form_actions
