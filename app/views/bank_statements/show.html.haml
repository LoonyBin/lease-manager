- content_for :title, "Bank Statement - #{@bank_statement.filename}"

.card.w-full.bg-base-100.shadow-xl.mx-auto
  .card-body
    .flex.justify-between.items-center.mb-6
      %div
        %h2.card-title.text-2xl= @bank_statement.filename
        %p.text-sm.text-base-content.opacity-60
          Uploaded: #{@bank_statement.uploaded_at&.strftime("%B %d, %Y at %H:%M")}
      = link_to "Back", bank_statements_path, class: "btn btn-ghost"

    .stats.shadow.mb-6
      .stat
        .stat-title Transactions
        .stat-value= @transactions.count
      .stat
        .stat-title Matched
        .stat-value.text-success= @transactions.matched.count
      .stat
        .stat-title Confirmed
        .stat-value.text-info= @transactions.confirmed.count
      .stat
        .stat-title Unmatched
        .stat-value.text-warning= @transactions.unmatched.count

    .overflow-x-auto
      %table.table.w-full
        %thead
          %tr
            %th Date
            %th Amount
            %th Description
            %th Reference
            %th Status
            %th Matched Payment
            %th Actions
        %tbody
          - @transactions.order(date: :desc).each do |txn|
            %tr{class: txn.confirmed? ? "opacity-50" : ""}
              %td= txn.date&.strftime("%b %d, %Y")
              %td{class: txn.amount.negative? ? "text-error" : "text-success"}
                = number_to_currency(txn.amount)
              %td.max-w-xs.truncate= txn.description
              %td= txn.reference
              %td
                - badge_class = case txn.status
                - when "confirmed" then "badge-success"
                - when "matched" then "badge-info"
                - when "rejected" then "badge-error"
                - else "badge-warning"
                %span{class: "badge #{badge_class}"}= txn.status.humanize
              %td
                - if txn.matched_payment
                  = link_to "Payment ##{txn.matched_payment.id}", "#", class: "link link-primary"
                  %br
                  %span.text-xs.opacity-60= txn.matched_payment.lease.tenant.name
                - else
                  %span.opacity-50 -
              %td
                - unless txn.confirmed? || txn.rejected?
                  - if txn.matched?
                    = button_to "Confirm", confirm_bank_transaction_path(txn), method: :patch, class: "btn btn-xs btn-success"
                    = button_to "Reject", reject_bank_transaction_path(txn), method: :patch, class: "btn btn-xs btn-error"
                  - else
                    %span.text-xs.opacity-50 No match found
                - elsif txn.rejected?
                  = button_to "Re-match", rematch_bank_transaction_path(txn), method: :patch, class: "btn btn-xs btn-warning"
