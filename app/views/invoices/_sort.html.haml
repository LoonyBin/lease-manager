= form_with url: invoices_path, method: :get, class: "flex flex-col gap-2" do |f|
  -# Preserve existing filter params
  - if params[:q].present?
    - params[:q].each do |key, value|
      - next if key == "s"
      = hidden_field_tag "q[#{key}]", value

  - current_sort = params.dig(:q, :s)
  - sort_options = [["Date (Newest)", "date desc"], ["Date (Oldest)", "date asc"], ["Invoice # (High to Low)", "number desc"], ["Invoice # (Low to High)", "number asc"], ["Property (A-Z)", "lease_property_name asc"], ["Property (Z-A)", "lease_property_name desc"], ["Tenant (A-Z)", "lease_tenant_name asc"], ["Tenant (Z-A)", "lease_tenant_name desc"], ["Amount (High to Low)", "total_amount desc"], ["Amount (Low to High)", "total_amount asc"], ["Status", "status asc"]]

  - sort_options.each do |label, value|
    %label.label.cursor-pointer.justify-start.gap-3.py-2.px-3.rounded-lg.hover:bg-base-300{class: current_sort == value ? "bg-base-300" : ""}
      %input.radio.radio-sm.radio-primary{type: "radio", name: "q[s]", value: value, checked: current_sort == value, onchange: "this.form.submit()"}
      %span.label-text= label

  - filter_params = params[:q].present? ? params[:q].to_unsafe_h.except("s") : {}
  .flex.gap-2.mt-4.pt-4.border-t.border-base-300
    = link_to "Clear Sort", invoices_path(q: filter_params.presence), class: "btn btn-ghost btn-sm flex-1"
