- content_for :page_title, "Finance"

- content_for :page_actions do
  %label.btn.btn-ghost.btn-sm.btn-square{for: "filter-drawer"}
    = heroicon "funnel", options: { class: "w-5 h-5" }

.drawer.drawer-end
  %input#filter-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content.flex.flex-col
    .card.w-full.bg-base-100.shadow-xl
      .card-body
        = render_active_filters(@q)

        .overflow-x-auto
          %table.table.table-zebra.w-full
            %thead
              %tr
                %th= sort_link(@q, :date, "Date")
                %th= sort_link(@q, :number, "Number")
                %th= sort_link(@q, :lease_property_name, "Property")
                %th= sort_link(@q, :lease_tenant_name, "Tenant")
                %th Amount
                %th= sort_link(@q, :status, "Status")
            %tbody
              - @invoices.each do |invoice|
                %tr.hover.cursor-pointer{data: { controller: "clickable-row", clickable_row_url_value: invoice_path(invoice), action: "click->clickable-row#click" }}
                  %td= invoice.date.strftime("%b %Y")
                  %td
                    = link_to invoice_path(invoice), class: "link link-hover" do
                      - if invoice.number.present?
                        .badge.badge-outline= invoice.number
                      - else
                        .badge.badge-ghost Draft
                  %td= invoice.lease.property.name
                  %td= invoice.lease.tenant.name
                  %td= number_to_currency(invoice.line_items.sum(:amount))
                  %td
                    %span{class: "badge badge-#{invoice.draft? ? 'ghost' : 'success'}"}
                      = invoice.status.humanize

        = paginate @invoices

  .drawer-side
    %label.drawer-overlay{for: "filter-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      %h3.text-lg.font-bold.mb-4 Filter Invoices
      = render "search"
