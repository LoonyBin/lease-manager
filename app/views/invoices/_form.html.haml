= simple_form_for(invoice) do |f|
  = f.error_notification
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?
  = f.hidden_field :document_type

  = f.grid_inputs do
    - if f.object.new_record?
      - if f.object.lease_id?
        = f.input :lease, col: 4, readonly: true
        = f.input :lease_id, as: :hidden
      - else
        = f.association :lease, col: 4, collection: leases, label_method: ->(l) { "#{l.tenant.name} - #{l.property.name}" }, label: "Lease (Tenant - Property)"
    = f.input :date, as: :date, html5: true
    = f.input :status, collection: Invoice.statuses.keys, include_blank: false

  %h3.text-lg.font-bold.mb-4 Line Items

  %div{ data: { controller: "nested-fields" } }
    %table.table.w-full.mb-4
      %thead
        %tr
          %th Description
          %th Category
          %th.text-right Amount
          %th.text-right Tax Rate (%)
          %th
      %tbody{ data: { nested_fields_target: "container" } }
        = f.simple_fields_for :line_items do |li|
          %tr
            %td
              = li.hidden_field :id
              = li.input_field :name, class: "input input-bordered input-sm w-full"
            %td
              = li.input_field :category, class: "input input-bordered input-sm w-full"
            %td.text-right
              = li.input_field :amount, class: "input input-bordered input-sm w-24 text-right"
            %td.text-right
              = li.input_field :tax_rate, class: "input input-bordered input-sm w-24 text-right"
            %td
              = li.label :_destroy, class: "cursor-pointer" do
                = li.check_box :_destroy, class: "checkbox checkbox-sm checkbox-error"
                %span.text-xs.text-error.ml-1 Delete

    %template{ data: { nested_fields_target: "template" } }
      %tr
        %td
          %input.input.input-bordered.input-sm.w-full{ type: "text", name: "invoice[line_items_attributes][NEW_RECORD][name]" }
        %td
          %input.input.input-bordered.input-sm.w-full{ type: "text", name: "invoice[line_items_attributes][NEW_RECORD][category]" }
        %td.text-right
          %input.input.input-bordered.input-sm.w-24.text-right{ type: "number", step: "any", name: "invoice[line_items_attributes][NEW_RECORD][amount]" }
        %td.text-right
          %input.input.input-bordered.input-sm.w-24.text-right{ type: "number", step: "any", name: "invoice[line_items_attributes][NEW_RECORD][tax_rate]", value: "0" }
        %td

    .mt-2
      %button.btn.btn-sm.btn-outline.btn-secondary{ type: "button", data: { action: "nested-fields#add" } }
        = heroicon "plus", options: { class: "w-4 h-4 mr-1" }
        Add Line Item

  = f.form_actions
