= search_form_for @q, class: "flex flex-col gap-4 p-4" do |f|
  %h3.text-lg.font-bold Filters
  .form-control
    = f.label :lease_tenant_name_cont, "Tenant", class: "label-text"
    = f.search_field :lease_tenant_name_cont, class: "input input-bordered input-sm w-full"
  .form-control
    = f.label :date_gteq, "Date From", class: "label-text"
    = f.date_field :date_gteq, class: "input input-bordered input-sm w-full"
  .form-control
    = f.label :date_lteq, "Date To", class: "label-text"
    = f.date_field :date_lteq, class: "input input-bordered input-sm w-full"
  .form-control
    = f.label :total_amount_gteq, "Amount Min", class: "label-text"
    = f.number_field :total_amount_gteq, class: "input input-bordered input-sm w-full", step: "0.01"
  .form-control
    = f.label :total_amount_lteq, "Amount Max", class: "label-text"
    = f.number_field :total_amount_lteq, class: "input input-bordered input-sm w-full", step: "0.01"
  .form-control
    = f.label :status_eq, "Status", class: "label-text"
    = f.select :status_eq, Invoice.statuses.map { |k, v| [k.humanize, v] }, { include_blank: true }, class: "select select-bordered select-sm w-full"

  .flex.gap-2.mt-4
    = f.submit "Apply Filters", class: "btn btn-primary btn-sm flex-1"
    = link_to "Clear", invoices_path, class: "btn btn-ghost btn-sm"
