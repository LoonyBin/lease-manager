- content_for :title do
  = @payment.refund? ? "Refund" : "Payment"
  %span.text-base.font-normal.opacity-60.ml-2= @payment.date.strftime("%b %d, %Y")
  - if @payment.draft?
    %span.badge.badge-warning.ml-2 Draft
  - elsif @payment.rejected?
    %span.badge.badge-error.ml-2 Rejected

- content_for :page_actions do
  - if policy(@payment).update?
    - if @payment.rejected?
      = button_to payment_path(@payment), method: :patch, params: { payment: { status: :confirmed } }, class: "btn btn-primary btn-sm", data: { turbo_confirm: "Reinstate this payment? This will re-allocate it to outstanding invoices." } do
        = heroicon "check", options: { class: "w-4 h-4" }
        Reinstate
    - else
      = button_to payment_path(@payment), method: :patch, params: { payment: { status: :rejected } }, class: "btn btn-ghost btn-sm text-error", data: { turbo_confirm: reject_confirmation_prompt(@payment) } do
        = heroicon "x-mark", options: { class: "w-4 h-4" }
        Reject
      - if @payment.draft?
        = button_to payment_path(@payment), method: :patch, params: { payment: { status: :confirmed } }, class: "btn btn-primary btn-sm", data: { turbo_confirm: "Confirm this payment? This will allocate it to outstanding invoices." } do
          = heroicon "check", options: { class: "w-4 h-4" }
          Confirm
  %label.btn.btn-ghost.btn-sm.btn-square{for: "history-drawer", title: "History"}
    = heroicon "clock", options: { class: "w-5 h-5" }

.drawer.drawer-end
  %input#history-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content
    .show-card
      .show-section
        .show-invoice-header
          .show-invoice-from
            %h3.font-bold.text-lg= @payment.lease.property.owner.name
            %p.text-sm.opacity-70= @payment.lease.property.owner.address
            %p.text-xs.opacity-50= @payment.lease.property.name
          .show-invoice-meta
            .show-field
              .show-field-label
                %span.font-bold.text-lg= @payment.refund? ? "Refund" : "Payment"
              .show-field-value
                %span #
                = @payment.id
            .show-field
              .show-field-label Date
              .show-field-value= @payment.date.strftime("%B %d, %Y")
            .show-field
              .show-field-label Status
              .show-field-value
                - if @payment.draft?
                  %span.resource-badge.resource-badge-warning Draft
                - elsif @payment.rejected?
                  %span.resource-badge.resource-badge-error Rejected
                - elsif @payment.confirmed?
                  %span.resource-badge.resource-badge-info Confirmed
                - else
                  %span.resource-badge.resource-badge-success= @payment.status.humanize

      .show-section
        %h3.show-section-title= @payment.refund? ? "Refunded To" : "Received From"
        .show-field-value
          %p.font-medium= @payment.lease.tenant.name
          %p.text-sm.opacity-70= @payment.lease.tenant.email
          %p.text-sm.opacity-70= @payment.lease.tenant.phone_number
          %p.text-xs.opacity-50.mt-1
            Lease:
            = "#{@payment.lease.start_date.strftime('%b %Y')} → #{@payment.lease.end_date&.strftime('%b %Y') || 'Ongoing'}"

      .show-section
        .flex.flex-wrap.gap-x-8.gap-y-4
          .show-field
            .show-field-label Mode
            .show-field-value= @payment.mode.humanize.titleize
          - if @payment.reference_number.present?
            .show-field
              .show-field-label Reference
              .show-field-value= @payment.reference_number
          .show-field.ml-auto.text-right
            .show-field-label Amount
            .show-field-value.font-bold= number_to_currency(@payment.amount, unit: "₹", precision: 0)

      - if @payment.attachment.attached?
        .show-section
          .show-section-header
            %h3.show-section-title Attachment
          .p-4
            - if @payment.attachment.content_type.start_with?("image/")
              = link_to rails_blob_path(@payment.attachment, disposition: "inline"), target: "_blank", class: "block" do
                = image_tag @payment.attachment, class: "max-w-full max-h-96 rounded-lg shadow-md"
            - else
              = link_to rails_blob_path(@payment.attachment, disposition: "inline"), target: "_blank", class: "btn btn-outline btn-sm" do
                = heroicon "document", options: { class: "w-4 h-4 mr-2" }
                View Attachment

      - payment_settlements = @payment.entries.settlements
      -# Find invoice entries that share transaction_ids with payment settlements
      - transaction_ids = payment_settlements.pluck(:transaction_id)
      - invoice_entries = Entry.where(transaction_id: transaction_ids).where.not(instrument: @payment).includes(:instrument)

      - if @payment.confirmed_or_later?
        .show-section
          .show-section-header
            %h3.show-section-title= @payment.refund? ? "Applied To" : "Allocated To"
            - if @payment.fully_allocated?
              %span.resource-badge.resource-badge-success Fully Allocated
            - else
              %span.resource-badge.resource-badge-amber
                = "#{number_to_currency(@payment.balance.abs, unit: '₹', precision: 0)} unallocated"

          - if invoice_entries.any?
            .overflow-x-auto
              %table.table.w-full
                %thead
                  %tr
                    %th.w-full= @payment.refund? ? "Credit Note" : "Invoice"
                    %th Date
                    %th.text-right Amount
                %tbody
                  - invoice_entries.each do |entry|
                    - invoice = entry.instrument
                    %tr
                      %td
                        = link_to invoice_path(invoice), class: "link link-hover font-medium" do
                          - if invoice.number.present?
                            = "##{invoice.number}"
                          - else
                            Draft
                      %td= invoice.date.strftime("%b %Y")
                      %td.text-right.font-medium= number_to_currency(entry.amount.abs, unit: "₹", precision: 0)
                %tfoot
                  %tr
                    %th.text-right{colspan: 2} Total Allocated
                    %th.text-right= number_to_currency(invoice_entries.sum { |e| e.amount.abs }, unit: "₹", precision: 0)
                  - if !@payment.fully_allocated?
                    %tr.text-warning
                      %th.text-right{colspan: 2} Unallocated
                      %th.text-right= number_to_currency(@payment.balance.abs, unit: "₹", precision: 0)
          - else
            .show-empty
              No invoices have been allocated to this payment yet.

  .drawer-side
    %label.drawer-overlay{for: "history-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      = render "shared/history_sidebar", item: @payment
