.card.w-full.bg-base-100.shadow-xl
  .card-body
    .flex.justify-between.items-center.mb-4
      %h2.card-title Payments
      = link_to "Record Payment", new_payment_path, class: "btn btn-primary"

    .overflow-x-auto
      %table.table.table-zebra.w-full
        %thead
          %tr
            %th Date
            %th Tenant
            %th Details
            %th Amount
            %th Allocations
        %tbody
          - @payments.each do |payment|
            %tr
              %td= payment.date.strftime("%b %d, %Y")
              %td
                %p.font-bold= payment.lease.tenant.name
                %p.text-xs.opacity-50= payment.lease.property.name
              %td
                %p.font-semibold= payment.mode.humanize.titleize
                - if payment.reference_number.present?
                  %p.text-xs.font-mono.opacity-70= payment.reference_number
              %td= number_to_currency(payment.amount)
              %td
                - if payment.payment_allocations.any?
                  %ul.list-disc.list-inside.text-xs
                    - payment.payment_allocations.each do |allocation|
                      %li
                        = number_to_currency(allocation.amount)
                        to Invoice
                        = link_to "##{allocation.invoice.number}", invoice_path(allocation.invoice), class: "link link-hover"
                - else
                  %span.badge.badge-ghost Unallocated
