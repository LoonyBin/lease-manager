.drawer.drawer-end
  %input#filter-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content.flex.flex-col
    .card.w-full.bg-base-100.shadow-xl
      .card-body
        .flex.justify-between.items-center.mb-4
          %h2.card-title Payments

          .flex.gap-2
            %label.btn.btn-ghost.btn-sm.gap-2{for: "filter-drawer"}
              = heroicon "funnel", options: { class: "w-4 h-4" }
              Filters
            - if policy(@payments.new).new?
              = link_to "Record Payment", new_payment_path, class: "btn btn-primary"

        = render_active_filters(@q)

        .overflow-x-auto
          %table.table.table-zebra.w-full
            %thead
              %tr
                %th= sort_link(@q, :date, "Date")
                %th= sort_link(@q, :lease_tenant_name, "Tenant")
                %th Details
                %th= sort_link(@q, :amount, "Amount")
                %th Allocations
            %tbody
              - @payments.each do |payment|
                %tr
                  %td= payment.date.strftime("%b %d, %Y")
                  %td
                    %p.font-bold= payment.lease.tenant.name
                    %p.text-xs.opacity-50= payment.lease.property.name
                  %td
                    %p.font-semibold= payment.mode.humanize.titleize
                    - if payment.reference_number.present?
                      %p.text-xs.font-mono.opacity-70= payment.reference_number
                  %td= number_to_currency(payment.amount)
                  %td
                    - settlement_entries = payment.entries.settlements
                    - if settlement_entries.any?
                      %ul.list-disc.list-inside.text-xs
                        - settlement_entries.each do |entry|
                          - Entry.where(transaction_id: entry.transaction_id).where.not(id: entry.id).each do |counterpart|
                            %li
                              = number_to_currency(entry.amount.abs)
                              to
                              = counterpart.instrument_type
                              - if counterpart.instrument_type == "Invoice" && counterpart.instrument.number.present?
                                = link_to "##{counterpart.instrument.number}", invoice_path(counterpart.instrument), class: "link link-hover"
                              - else
                                = "##{counterpart.instrument_id}"
                    - elsif payment.balance.abs.positive?
                      %span.badge.badge-warning
                        = number_to_currency(payment.balance.abs)
                        unallocated
                    - else
                      %span.badge.badge-success Fully allocated

        = paginate @payments

  .drawer-side
    %label.drawer-overlay{for: "filter-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      %h3.text-lg.font-bold.mb-4 Filter Payments
      = render "search"
