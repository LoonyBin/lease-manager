- content_for :page_title, "Payments"

- content_for :page_actions do
  -# View toggle (desktop only)
  .view-toggle-group.hidden.lg:flex
    %input#view-toggle.view-toggle-input{type: "checkbox"}
    %label.view-toggle-btn{for: "view-toggle", data: { view: "card" }, title: "Card view"}
      = heroicon "squares-2x2", options: { class: "w-4 h-4" }
    %label.view-toggle-btn{for: "view-toggle", data: { view: "table" }, title: "Table view"}
      = heroicon "list-bullet", options: { class: "w-4 h-4" }
  %label.btn.btn-ghost.btn-sm.btn-square{for: "sort-drawer", title: "Sort"}
    = heroicon "bars-arrow-down", options: { class: "w-5 h-5" }
  %label.btn.btn-ghost.btn-sm.btn-square{for: "filter-drawer", title: "Filter"}
    = heroicon "funnel", options: { class: "w-5 h-5" }
  - if policy(@payments.new).new?
    = link_to new_payment_path, class: "btn btn-ghost btn-sm btn-square", title: "Record Payment" do
      = heroicon "plus", options: { class: "w-5 h-5" }

.drawer.drawer-end
  %input#sort-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content
    .drawer.drawer-end
      %input#filter-drawer.drawer-toggle{type: "checkbox"}
      .drawer-content.flex.flex-col
        = render_active_filters(@q)

        -# Single markup - CSS handles card vs table display
        .payment-list
          -# Table header (visible only in table view on desktop)
          .payment-list-header
            .payment-col-amount Amount
            .payment-col-tenant Tenant
            .payment-col-mode Mode
            .payment-col-amount-table Amount
            .payment-col-status Status
            .payment-col-actions Actions

          -# Payment items
          - @payments.each do |payment|
            - settlement_entries = payment.entries.settlements
            - fully_allocated = payment.balance.abs.zero?

            .payment-item
              .payment-col-amount
                .payment-item-amount-wrapper
                  .payment-item-icon
                    = heroicon "currency-rupee", options: { class: "w-5 h-5" }
                  %span.payment-item-amount= number_to_currency(payment.amount, unit: "₹", precision: 0)
                .payment-item-date= payment.date.strftime("%b %d, %Y")
                .payment-item-compact
                  %span.date= payment.date.strftime("%b %d, %Y")
              .payment-col-tenant
                .payment-item-tenant= payment.lease.tenant.name
                .payment-item-property= payment.lease.property.name
              .payment-col-mode
                .payment-item-mode
                  = payment.mode.humanize.titleize
                - if payment.reference_number.present?
                  .payment-item-reference= payment.reference_number
              .payment-col-amount-table
                .payment-item-compact
                  %span.amount= number_to_currency(payment.amount, unit: "₹", precision: 0)
              .payment-col-status
                - if fully_allocated
                  %span.payment-item-badge.payment-item-badge-allocated Allocated
                - elsif settlement_entries.any?
                  .payment-item-allocations
                    %span.payment-item-badge.payment-item-badge-unallocated
                      = number_to_currency(payment.balance.abs, unit: "₹", precision: 0)
                      pending
                - else
                  %span.payment-item-badge.payment-item-badge-unallocated
                    = number_to_currency(payment.balance.abs, unit: "₹", precision: 0)
                    unallocated
              .payment-col-actions

        = paginate @payments

      .drawer-side
        %label.drawer-overlay{for: "filter-drawer", aria: { label: "close sidebar" }}
        .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
          %h3.text-lg.font-bold.mb-4 Filter Payments
          = render "search"

  .drawer-side
    %label.drawer-overlay{for: "sort-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      %h3.text-lg.font-bold.mb-4 Sort Payments
      = render "sort"
