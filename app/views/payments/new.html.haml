.card.w-full.max-w-lg.bg-base-100.shadow-xl.mx-auto
  .card-body
    %h2.card-title.mb-4 Record Payment

    = simple_form_for @payment do |f|
      = f.error_notification

      .form-control.w-full.max-w-xs.mb-4
        %label.label
          %span.label-text Lease (Tenant - Property)
        = f.input_field :lease_id, collection: @leases, label_method: ->(l) { "#{l.tenant.name} - #{l.property.name}" }, value_method: :id, class: "select select-bordered w-full"
        = f.error :lease_id

      .form-control.w-full.max-w-xs.mb-4
        = f.input :date, as: :date, html5: true, input_html: { class: "input input-bordered w-full" }, wrapper: false, label_html: { class: "label-text" }

      .form-control.w-full.max-w-xs.mb-6
        = f.input :amount, input_html: { class: "input input-bordered w-full", min: 0, step: 0.01 }, wrapper: false, label_html: { class: "label-text" }

      .card-actions.justify-end
        = link_to "Cancel", payments_path, class: "btn btn-ghost"
        = f.button :submit, "Save Payment", class: "btn btn-primary"
