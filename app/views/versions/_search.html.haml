= search_form_for @q, class: "flex flex-col gap-4" do |f|
  .form-control
    = f.label :item_type_eq, "Item Type", class: "label-text"
    = f.select :item_type_eq, Version.distinct.pluck(:item_type).sort, { include_blank: "All" }, class: "select select-bordered select-sm w-full"

  .form-control
    = f.label :item_id_eq, "ID", class: "label-text"
    = f.search_field :item_id_eq, class: "input input-bordered input-sm w-full"

  .form-control
    = f.label :created_at_gteq, "Time From", class: "label-text"
    = f.datetime_field :created_at_gteq, class: "input input-bordered input-sm w-full"
  .form-control
    = f.label :created_at_lteq, "Time To", class: "label-text"
    = f.datetime_field :created_at_lteq, class: "input input-bordered input-sm w-full"

  .form-control
    = f.label :event_eq, "Event", class: "label-text"
    = f.select :event_eq, %w[create update destroy].map { |e| [e.humanize, e] }, { include_blank: "All" }, class: "select select-bordered select-sm w-full"

  .flex.gap-2.mt-4
    = f.submit "Apply Filters", class: "btn btn-primary btn-sm flex-1"
    = link_to "Clear", versions_path, class: "btn btn-ghost btn-sm"
