- content_for :page_title do
  = t(".title")
  %span.text-base.font-normal.opacity-60.ml-2 ##{@version.id}

- content_for :page_actions do
  - if @version.item.present?
    = link_to polymorphic_path(@version.item), class: "btn btn-ghost btn-sm btn-square", title: t(".view_resource") do
      = heroicon "arrow-top-right-on-square", options: { class: "w-5 h-5" }
  - if VersionPolicy.new(current_user, @version).destroy?
    = button_to version_path(@version.id), method: :delete, class: "btn btn-ghost btn-sm btn-square text-error", data: { turbo_confirm: t(".delete_confirm") }, title: "Delete" do
      = heroicon "trash", options: { class: "w-5 h-5" }

.show-card
  .show-section
    .show-field
      .show-field-label= t(".resource")
      .show-field-value
        = @version.item_type
        %span.resource-badge.resource-badge-neutral.ml-2 ##{@version.item_id}
    .show-field
      .show-field-label= t(".event")
      .show-field-value= event_badge(@version.event)
    .show-field
      .show-field-label= t(".date")
      .show-field-value= @version.created_at.strftime("%Y-%m-%d %H:%M:%S")
    .show-field
      .show-field-label= t(".user")
      .show-field-value
        - if @version.whodunnit.present?
          - user = User.find_by(id: @version.whodunnit)
          = user&.name || t(".unknown_user")
        - else
          %span.opacity-50= t(".system")

  - if @version.object_changes.present?
    .show-section
      %h3.show-section-title= t(".changes")
      .overflow-x-auto
        %table.table.w-full
          %thead
            %tr
              %th= t(".table.field")
              %th= t(".table.from")
              %th= t(".table.to")
          %tbody
            - changes = JSON.parse(@version.object_changes)
            - changes.each do |field, (from_val, to_val)|
              - next if %w[created_at updated_at].include?(field)
              %tr
                %td.font-medium= field.humanize
                %td
                  - if from_val.nil?
                    %span.opacity-50= t(".empty")
                  - else
                    = from_val
                %td
                  - if to_val.nil?
                    %span.opacity-50= t(".empty")
                  - else
                    = to_val

  - elsif @version.object.present?
    .show-section
      %h3.show-section-title= t(".previous_state")
      .overflow-x-auto
        %table.table.w-full
          %thead
            %tr
              %th= t(".table.field")
              %th= t(".table.value")
          %tbody
            - obj = JSON.parse(@version.object)
            - obj.each do |field, value|
              - next if %w[created_at updated_at].include?(field)
              %tr
                %td.font-medium= field.humanize
                %td
                  - if value.present?
                    = value
                  - else
                    %span.opacity-50= t(".empty")
