.flex.justify-between.items-start.mb-6
  %h1.text-2xl.font-bold
    = t(".title")
    %span.badge.badge-outline.ml-2= "##{@version.id}"
  - if VersionPolicy.new(current_user, @version).destroy?
    = button_to version_path(@version.id), method: :delete, class: "btn btn-sm btn-ghost text-error", data: { turbo_confirm: t(".delete_confirm") }, aria: { label: "Delete" } do
      = heroicon "trash", options: { class: "w-4 h-4" }

.grid.grid-cols-1.md:grid-cols-2.gap-4.mb-6
  %div
    %h3.font-bold.text-sm.opacity-70= t(".resource")
    %p
      = @version.item_type
      %span.badge.badge-ghost.badge-sm.ml-1= "##{@version.item_id}"
  %div
    %h3.font-bold.text-sm.opacity-70= t(".event")
    %p= event_badge(@version.event)
  %div
    %h3.font-bold.text-sm.opacity-70= t(".date")
    %p= @version.created_at.strftime("%Y-%m-%d %H:%M:%S")
  %div
    %h3.font-bold.text-sm.opacity-70= t(".user")
    %p
      - if @version.whodunnit.present?
        - user = User.find_by(id: @version.whodunnit)
        = user&.name || t(".unknown_user")
      - else
        %span.opacity-50= t(".system")

- if @version.item.present?
  .mb-6
    = link_to t(".view_resource"), polymorphic_path(@version.item), class: "btn btn-sm btn-primary"

.divider

- if @version.object_changes.present?
  %h3.text-lg.font-bold.mb-4= t(".changes")
  .overflow-x-auto
    %table.table.w-full
      %thead
        %tr
          %th= t(".table.field")
          %th= t(".table.from")
          %th= t(".table.to")
      %tbody
        - changes = JSON.parse(@version.object_changes)
        - changes.each do |field, (from_val, to_val)|
          - next if %w[created_at updated_at].include?(field)
          %tr
            %td.font-medium= field.humanize
            %td
              - if from_val.nil?
                %span.opacity-50= t(".empty")
              - else
                = from_val
            %td
              - if to_val.nil?
                %span.opacity-50= t(".empty")
              - else
                = to_val
- elsif @version.object.present?
  %h3.text-lg.font-bold.mb-4= t(".previous_state")
  .overflow-x-auto
    %table.table.w-full
      %thead
        %tr
          %th= t(".table.field")
          %th= t(".table.value")
      %tbody
        - obj = JSON.parse(@version.object)
        - obj.each do |field, value|
          - next if %w[created_at updated_at].include?(field)
          %tr
            %td.font-medium= field.humanize
            %td
              - if value.present?
                = value
              - else
                %span.opacity-50= t(".empty")
