.flex.justify-between.items-start.mb-6
  %h1.text-2xl.font-bold= @owner.name
  - if policy(@owner).edit?
    = link_to edit_owner_path(@owner), class: "btn btn-sm btn-ghost", aria: { label: "Edit" } do
      = heroicon "pencil-square", options: { class: "w-4 h-4" }

.grid.grid-cols-1.md:grid-cols-2.gap-6.mb-6
  %div
    %h3.font-bold.text-sm.opacity-70 Address
    %p.whitespace-pre-wrap= @owner.address

  %div
    %h3.font-bold.text-sm.opacity-70 Invoice Sequence
    %p= @owner.invoice_sequence

.divider

%h3.text-lg.font-bold.mb-4 Properties
- if @properties.any?
  .overflow-x-auto
    %table.table
      %thead
        %tr
          %th Name
          %th Leases
      %tbody
        - @properties.each do |property|
          %tr.hover.cursor-pointer{data: { controller: "clickable-row", clickable_row_url_value: property_path(property), action: "click->clickable-row#click" }}
            %td.font-medium= link_to property.name, property, class: "link link-hover"
            %td= property.leases.count
- else
  %p.text-base-content.opacity-60 No properties assigned.

.divider

%h3.text-lg.font-bold.mb-4 Associated Users

- if @owner.users.any?
  .flex.flex-wrap.gap-2.mb-4
    - @owner.user_associations.includes(:user).each do |assoc|
      .badge.badge-outline.gap-2
        = assoc.user.name
        - if policy(assoc).destroy?
          = button_to user_association_path(assoc), method: :delete, class: "btn btn-ghost btn-xs p-0", data: { turbo_confirm: "Remove this association?" }, aria: { label: "Remove #{assoc.user.name}" } do
            = heroicon "x-mark", options: { class: "w-4 h-4" }
- else
  %p.text-base-content.opacity-50.mb-4 No users associated.

- if policy(UserAssociation).create?
  = form_with model: UserAssociation.new, class: "flex gap-2" do |f|
    = f.hidden_field :associable_type, value: "Owner"
    = f.hidden_field :associable_id, value: @owner.id
    = f.collection_select :user_id, User.where.not(id: @owner.user_ids).order(:name), :id, :name, { prompt: "Select user to add..." }, class: "select select-bordered select-sm flex-1"
    = f.submit "Add", class: "btn btn-sm btn-primary"
