- content_for :page_title, @owner.name

- content_for :page_actions do
  - if policy(@owner).edit?
    = link_to edit_owner_path(@owner), class: "btn btn-ghost btn-sm btn-square", title: "Edit" do
      = heroicon "pencil-square", options: { class: "w-5 h-5" }
  %label.btn.btn-ghost.btn-sm.btn-square{for: "history-drawer", title: "History"}
    = heroicon "clock", options: { class: "w-5 h-5" }

.drawer.drawer-end
  %input#history-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content
    .show-card
      .show-section
        .show-field
          .show-field-label Address
          .show-field-value.whitespace-pre-wrap= @owner.address
        .show-field
          .show-field-label Invoice Sequence
          .show-field-value= @owner.invoice_sequence

      .show-section
        .show-section-header
          %h3.show-section-title Properties
          = link_to properties_path(q: { owner_id_eq: @owner.id }), class: "btn btn-ghost btn-xs", title: "View all" do
            = heroicon "arrows-pointing-out", options: { class: "w-4 h-4" }

        - if @properties.any?
          .show-list
            - @properties.each do |property|
              .show-list-item{data: { controller: "clickable-row", clickable_row_url_value: property_path(property), action: "click->clickable-row#click" }}
                .show-list-item-title= link_to property.name, property, class: "link link-primary"
                .show-list-item-meta= property.address.truncate(40)
                .show-list-item-badge
                  %span.resource-badge.resource-badge-neutral
                    = pluralize(property.leases.count, "lease")
        - else
          .show-empty No properties

      .show-section
        %h3.show-section-title Associated Users

        - if @owner.users.any?
          .show-tags
            - @owner.user_associations.includes(:user).each do |assoc|
              .show-tag
                = assoc.user.name
                - if policy(assoc).destroy?
                  = button_to user_association_path(assoc), method: :delete, class: "show-tag-remove", data: { turbo_confirm: "Remove this association?" }, aria: { label: "Remove #{assoc.user.name}" } do
                    = heroicon "x-mark", options: { class: "w-3 h-3" }
        - else
          .show-empty.mb-4 No users associated

        - if policy(UserAssociation).create?
          = form_with model: UserAssociation.new, class: "show-inline-form" do |f|
            = f.hidden_field :associable_type, value: "Owner"
            = f.hidden_field :associable_id, value: @owner.id
            = f.collection_select :user_id, User.where.not(id: @owner.user_ids).order(:name), :id, :name, { prompt: "Select user..." }, class: "select select-bordered select-sm flex-1"
            = f.submit "Add", class: "btn btn-sm btn-primary"

  .drawer-side
    %label.drawer-overlay{for: "history-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      = render "shared/history_sidebar", item: @owner
