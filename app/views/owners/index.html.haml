.card.w-full.bg-base-100.shadow-xl
  .card-body
    .flex.justify-between.items-center.mb-4
      %h2.card-title Owners
      = link_to "New Owner", new_owner_path, class: "btn btn-primary"

    .overflow-x-auto
      %table.table.table-zebra.w-full
        %thead
          %tr
            %th Name
            %th Address
            %th Invoice Sequence
            %th Properties
            %th Actions
        %tbody
          - @owners.each do |owner|
            %tr
              %td= link_to owner.name, owner_path(owner), class: "link link-hover font-bold"
              %td= owner.address
              %td= owner.invoice_sequence
              %td= owner.properties.count
              %td
                .join
                  = link_to "Edit", edit_owner_path(owner), class: "btn btn-xs btn-ghost join-item"
                  = button_to "Delete", owner_path(owner), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-xs btn-ghost text-error join-item"
