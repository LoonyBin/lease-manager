- content_for :page_title, "Owners"

- content_for :page_actions do
  -# View toggle (desktop only)
  .view-toggle-group.hidden.lg:flex
    %input#view-toggle.view-toggle-input{type: "checkbox"}
    %label.view-toggle-btn{for: "view-toggle", data: { view: "card" }, title: "Card view"}
      = heroicon "squares-2x2", options: { class: "w-4 h-4" }
    %label.view-toggle-btn{for: "view-toggle", data: { view: "table" }, title: "Table view"}
      = heroicon "list-bullet", options: { class: "w-4 h-4" }
  %label.btn.btn-ghost.btn-sm.btn-square{for: "sort-drawer", title: "Sort"}
    = heroicon "bars-arrow-down", options: { class: "w-5 h-5" }
  %label.btn.btn-ghost.btn-sm.btn-square{for: "filter-drawer", title: "Filter"}
    = heroicon "funnel", options: { class: "w-5 h-5" }
  - if policy(@owners.new).new?
    = link_to new_owner_path, class: "btn btn-ghost btn-sm btn-square", title: "New Owner" do
      = heroicon "plus", options: { class: "w-5 h-5" }

.drawer.drawer-end
  %input#sort-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content
    .drawer.drawer-end
      %input#filter-drawer.drawer-toggle{type: "checkbox"}
      .drawer-content.flex.flex-col
        = render_active_filters(@q)

        -# Single markup - CSS handles card vs table display
        .resource-list.owner-list
          -# Table header (visible only in table view on desktop)
          .resource-list-header.owner-list-header
            .owner-col-name Name
            .owner-col-address Address
            .owner-col-properties Properties
            .owner-col-actions Actions

          -# Owner items
          - @owners.each do |owner|
            - properties_count = owner.properties.count

            .resource-item.owner-item{data: { controller: "clickable-row", clickable_row_url_value: owner_path(owner), action: "click->clickable-row#click" }}
              .resource-col-header.owner-col-name
                .resource-item-icon
                  = heroicon "briefcase", options: { class: "w-5 h-5" }
                = link_to owner.name, owner, class: "resource-item-title"
              .resource-col.owner-col-address
                .resource-item-meta
                  = heroicon "map-pin", options: { class: "w-3.5 h-3.5 shrink-0 hidden-table" }
                  %span= owner.address
              .resource-col-flex.owner-col-properties
                - if properties_count > 0
                  %span.resource-badge.resource-badge-success
                    = pluralize(properties_count, "property", "properties")
                - else
                  %span.resource-badge.resource-badge-neutral No properties
              .resource-col-actions.owner-col-actions
                .resource-item-actions
                  - if policy(owner).edit?
                    = link_to edit_owner_path(owner), class: "btn btn-sm btn-ghost", aria: { label: "Edit #{owner.name}" } do
                      = heroicon "pencil-square", options: { class: "w-4 h-4" }
                  - if policy(owner).destroy?
                    = button_to owner_path(owner), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-ghost text-error", aria: { label: "Delete #{owner.name}" } do
                      = heroicon "trash", options: { class: "w-4 h-4" }
                = link_to owner, class: "resource-item-link" do
                  View Details
                  = heroicon "chevron-right", options: { class: "w-4 h-4" }

        = paginate @owners

      .drawer-side
        %label.drawer-overlay{for: "filter-drawer", aria: { label: "close sidebar" }}
        .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
          %h3.text-lg.font-bold.mb-4 Filter Owners
          = render "search"

  .drawer-side
    %label.drawer-overlay{for: "sort-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      %h3.text-lg.font-bold.mb-4 Sort Owners
      = render "sort"
