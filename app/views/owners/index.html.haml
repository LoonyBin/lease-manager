.flex.justify-between.items-center.mb-6
  %h1.text-2xl.font-bold Owners
  - if policy(@owners.new).new?
    = link_to "New Owner", new_owner_path, class: "btn btn-primary"

.mb-4
  = search_form_for @q, class: "flex gap-2 items-end" do |f|
    .form-control
      = f.label :name_cont, "Name", class: "label-text"
      = f.search_field :name_cont, class: "input input-bordered input-sm"
    .form-control
      = f.label :address_cont, "Address", class: "label-text"
      = f.search_field :address_cont, class: "input input-bordered input-sm"
    = f.submit "Search", class: "btn btn-sm btn-secondary"
    = link_to "Clear", owners_path, class: "btn btn-sm btn-ghost"

.overflow-x-auto
  %table.table.w-full
    %thead
      %tr
        %th= sort_link(@q, :name, "Name")
        %th= sort_link(@q, :address, "Address")
        %th Invoice Sequence
        %th Properties
        %th.text-center Actions
    %tbody
      - @owners.each do |owner|
        %tr.hover.cursor-pointer{data: { controller: "clickable-row", clickable_row_url_value: owner_path(owner), action: "click->clickable-row#click" }}
          %td.font-medium= link_to owner.name, owner, class: "link link-hover"
          %td= owner.address
          %td= owner.invoice_sequence
          %td= owner.properties.count
          %td.text-center
            - if policy(owner).edit? || policy(owner).destroy?
              .join
                - if policy(owner).edit?
                  = link_to edit_owner_path(owner), class: "btn btn-sm btn-ghost join-item", aria: { label: "Edit #{owner.name}" } do
                    = heroicon "pencil-square", options: { class: "w-4 h-4" }
                - if policy(owner).destroy?
                  = button_to owner_path(owner), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-ghost text-error join-item", aria: { label: "Delete #{owner.name}" } do
                    = heroicon "trash", options: { class: "w-4 h-4" }

= paginate @owners
