!!!
%html
  %head
    = render 'layouts/head'
  %body.bg-base-200.font-sans.min-h-screen
    = render 'shared/navbar'

    %main.container.mx-auto.px-4.pb-12
      - if notice
        .alert.alert-success.mb-4
          %span= notice
      - if alert
        .alert.alert-error.mb-4
          %span= alert

      = content_for?(:nested_layout_content) ? yield(:nested_layout_content) : yield
