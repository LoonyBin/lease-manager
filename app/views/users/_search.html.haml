= search_form_for @q, class: "flex flex-col gap-4" do |f|
  .form-control
    = f.label :name_cont, "Name", class: "label-text"
    = f.search_field :name_cont, class: "input input-bordered input-sm w-full"
  .form-control
    = f.label :email_cont, "Email", class: "label-text"
    = f.search_field :email_cont, class: "input input-bordered input-sm w-full"
  .form-control
    = f.label :role_eq, "Role", class: "label-text"
    = f.select :role_eq, User.roles.keys.map { |r| [r.titleize, r] }, { include_blank: "All" }, class: "select select-bordered select-sm w-full"

  .flex.gap-2.mt-4
    = f.submit "Apply Filters", class: "btn btn-primary btn-sm flex-1"
    = link_to "Clear", users_path, class: "btn btn-ghost btn-sm"
