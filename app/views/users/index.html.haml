- content_for :page_title, "Users"

.drawer.drawer-end
  %input#filter-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content.flex.flex-col
    -# Page actions
    .flex.justify-end.items-center.mb-6.gap-2
      %label.btn.btn-ghost.btn-sm.gap-2{for: "filter-drawer"}
        = heroicon "funnel", options: { class: "w-4 h-4" }
        Filters
      - if policy(@users.new).new?
        = link_to 'New User', new_user_path, class: "btn btn-primary btn-sm lg:btn-md"

    = render_active_filters(@q)

    .overflow-x-auto
      %table.table.w-full
        %thead
          %tr
            %th= sort_link(@q, :name, "Name")
            %th= sort_link(@q, :email, "Email")
            %th= sort_link(@q, :provider, "Provider")
            %th= sort_link(@q, :role, "Role")
            %th.text-center Actions
        %tbody
          - @users.each do |user|
            %tr.hover.cursor-pointer{data: { controller: "clickable-row", clickable_row_url_value: user_path(user), action: "click->clickable-row#click" }}
              %td.font-medium= link_to user.name, user, class: "link link-hover"
              %td= user.email
              %td= user.provider
              %td= user.role
              %td.text-center
                - if policy(user).edit? || policy(user).destroy?
                  .join
                    - if policy(user).edit?
                      = link_to edit_user_path(user), class: "btn btn-sm btn-ghost join-item", aria: { label: "Edit #{user.name}" } do
                        = heroicon "pencil-square", options: { class: "w-4 h-4" }
                    - if policy(user).destroy?
                      = link_to user, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn btn-sm btn-ghost text-error join-item", aria: { label: "Delete #{user.name}" } do
                        = heroicon "trash", options: { class: "w-4 h-4" }

    = paginate @users

  .drawer-side
    %label.drawer-overlay{for: "filter-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      %h3.text-lg.font-bold.mb-4 Filter Users
      = render "search"
