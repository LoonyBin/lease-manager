- content_for :page_title, @user.name

- content_for :page_actions do
  - if policy(@user).edit?
    = link_to edit_user_path(@user), class: "btn btn-ghost btn-sm btn-square", title: "Edit" do
      = heroicon "pencil-square", options: { class: "w-5 h-5" }
  - if policy(@user).destroy?
    = button_to user_path(@user), method: :delete, class: "btn btn-ghost btn-sm btn-square text-error", data: { turbo_confirm: "Are you sure you want to delete this user?" }, title: "Delete" do
      = heroicon "trash", options: { class: "w-5 h-5" }
  %label.btn.btn-ghost.btn-sm.btn-square{for: "history-drawer", title: "History"}
    = heroicon "clock", options: { class: "w-5 h-5" }

.drawer.drawer-end
  %input#history-drawer.drawer-toggle{type: "checkbox"}
  .drawer-content
    .show-card
      .show-section
        .show-field
          .show-field-label Email
          .show-field-value= mail_to @user.email, class: "link link-primary"
        .show-field
          .show-field-label Role
          .show-field-value
            - if @user.admin?
              %span.resource-badge.resource-badge-warning Admin
            - else
              %span.resource-badge.resource-badge-success Normal
        .show-field
          .show-field-label Provider
          .show-field-value
            %span.resource-badge.resource-badge-neutral= @user.provider.titleize
        .show-field
          .show-field-label UID
          .show-field-value.font-mono.text-sm= @user.uid

      .show-section
        %h3.show-section-title Associated Owners

        - if @user.owners.any?
          .show-tags
            - @user.user_associations.includes(:associable).where(associable_type: "Owner").each do |assoc|
              .show-tag
                = link_to assoc.associable.name, assoc.associable, class: "link link-hover"
                - if policy(assoc).destroy?
                  = button_to user_association_path(assoc), method: :delete, class: "show-tag-remove", data: { turbo_confirm: "Remove this association?" }, aria: { label: "Remove #{assoc.associable.name}" } do
                    = heroicon "x-mark", options: { class: "w-3 h-3" }
        - else
          .show-empty.mb-4 No owners associated

        - if policy(UserAssociation).create?
          = form_with model: UserAssociation.new, class: "show-inline-form" do |f|
            = f.hidden_field :user_id, value: @user.id
            = f.hidden_field :associable_type, value: "Owner"
            = f.collection_select :associable_id, Owner.where.not(id: @user.owner_ids).order(:name), :id, :name, { prompt: "Select owner..." }, class: "select select-bordered select-sm flex-1"
            = f.submit "Add", class: "btn btn-sm btn-primary"

      .show-section
        %h3.show-section-title Associated Tenants

        - if @user.tenants.any?
          .show-tags
            - @user.user_associations.includes(:associable).where(associable_type: "Tenant").each do |assoc|
              .show-tag
                = link_to assoc.associable.name, assoc.associable, class: "link link-hover"
                - if policy(assoc).destroy?
                  = button_to user_association_path(assoc), method: :delete, class: "show-tag-remove", data: { turbo_confirm: "Remove this association?" }, aria: { label: "Remove #{assoc.associable.name}" } do
                    = heroicon "x-mark", options: { class: "w-3 h-3" }
        - else
          .show-empty.mb-4 No tenants associated

        - if policy(UserAssociation).create?
          = form_with model: UserAssociation.new, class: "show-inline-form" do |f|
            = f.hidden_field :user_id, value: @user.id
            = f.hidden_field :associable_type, value: "Tenant"
            = f.collection_select :associable_id, Tenant.where.not(id: @user.tenant_ids).order(:name), :id, :name, { prompt: "Select tenant..." }, class: "select select-bordered select-sm flex-1"
            = f.submit "Add", class: "btn btn-sm btn-primary"

  .drawer-side
    %label.drawer-overlay{for: "history-drawer", aria: { label: "close sidebar" }}
    .menu.p-4.w-80.min-h-full.bg-base-200.text-base-content
      = render "shared/history_sidebar", item: @user
