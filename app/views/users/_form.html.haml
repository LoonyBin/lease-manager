= simple_form_for(user) do |f|
  = f.error_notification
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

  = f.grid_inputs do
    = f.input :name
    = f.input :email
    = f.input :provider
    = f.input :role, collection: User.roles.keys, include_blank: false
    = f.input :uid

  = f.form_actions
