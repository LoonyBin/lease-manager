-# User profile - simple link to user's profile page
- if logged_in?
  = link_to user_path(current_user), class: "user-profile-link" do
    .user-avatar
      %span= current_user.initials
    .user-details
      .user-name= current_user.name
      .user-role= current_user.role.titleize
- elsif controller_name != 'sessions'
  = link_to 'Login', login_path, class: "btn btn-sm btn-primary"
