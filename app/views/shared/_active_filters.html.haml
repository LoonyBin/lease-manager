.flex.flex_wrap.gap-2.mb-4
  - filters.each do |filter|
    .badge.badge-primary.badge-outline.gap-2.p-3
      = filter[:label]
      = link_to heroicon("x-mark", options: { class: "w-3 h-3" }), filter[:url], class: "hover:text-primary-focus"
  = link_to t("helpers.links.clear"), url_for(q: nil), class: "btn btn-ghost btn-xs text-xs"
