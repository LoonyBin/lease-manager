-# Renders audit trail history for an item
-# Usage: = render "shared/item_history", item: @lease
- versions = item.versions.order(created_at: :desc).limit(10)
- if versions.any?
  .divider

  %h3.text-lg.font-bold.mb-4= t("shared.item_history.title")

  .overflow-x-auto
    %table.table.table-sm.w-full
      %thead
        %tr
          %th= t("shared.item_history.table.date")
          %th= t("shared.item_history.table.event")
          %th= t("shared.item_history.table.user")
          %th= t("shared.item_history.table.changes")
          %th
      %tbody
        - versions.each do |version|
          %tr
            %td.text-sm= version.created_at.strftime("%Y-%m-%d %H:%M")
            %td
              %span{class: event_badge_class(version.event)}
                = version.event.humanize
            %td.text-sm
              - if version.whodunnit.present?
                - user = User.find_by(id: version.whodunnit)
                = user&.name || t("shared.item_history.unknown_user")
              - else
                %span.opacity-50= t("shared.item_history.system")
            %td.text-sm
              - if version.object_changes.present?
                - changes = JSON.parse(version.object_changes)
                - display_changes = changes.except("created_at", "updated_at")
                - if display_changes.any?
                  .flex.flex-wrap.gap-1
                    - display_changes.keys.first(3).each do |field|
                      %span.badge.badge-ghost.badge-xs= field.humanize
                    - if display_changes.keys.size > 3
                      %span.badge.badge-ghost.badge-xs= "+#{display_changes.keys.size - 3}"
              - else
                %span.opacity-50 -
            %td
              = link_to t("shared.item_history.view"), version_path(version), class: "btn btn-xs btn-ghost"

  - if item.versions.count > 10
    .text-center.mt-2
      = link_to t("shared.item_history.view_all", count: item.versions.count), versions_path(item_type: item.class.name, item_id: item.id), class: "btn btn-sm btn-ghost"
